@model Practical_7.Models.Feedback
@{
    Layout = "~/Views/Shared/_LayoutView.cshtml";
}
<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Feedback Form</title>
</head>
<body>
    <div>
        @Html.Partial("_StudentInfo")
        @using (Html.BeginForm())
        {
            <table>
                <tr>
                    <td>@Html.LabelFor(v => v.EnrollmentNo)</td>
                    <td>@Html.EditorFor(v => v.EnrollmentNo)</td>

                </tr>
                <tr>
                    <td>@Html.LabelFor(model => model.StudentName)</td>
                    <td>
                        @Html.TextBoxFor(model =>
                model.StudentName)
                </td>
            </tr>
            <tr>
                <td>@Html.LabelFor(model => model.Subject)</td>
                <td>@Html.TextBoxFor(model => model.Subject)</td>
            </tr>
            <tr>
                <td>@Html.LabelFor(model => model.Rating)</td>
                <td>@Html.TextBoxFor(model => model.Rating)</td>

            </tr>
            <tr>
                <td>@Html.LabelFor(model => model.Comments)</td>
                <td>@Html.TextAreaFor(model => model.Comments)</td>

            </tr>
        </table>
        <p>
            <input type="submit" value="Submit Feedback" />
        </p>
    }
        <br />
        <p>
            @Html.ActionLink("Back to Home", "Index", "Feedback")
        </p>
    </div>
</body>
</html>