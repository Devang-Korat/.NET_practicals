using System;
using System.Data;
using System.Data.SqlClient;
using System.Web.UI;

namespace WebApplication12
{
    public partial class Default : System.Web.UI.Page
    {
        string cs = @"Data Source=(LocalDB)\MSSQLLocalDB;AttachDbFilename=C:\Users\student\source\repos\WebApplication12\WebApplication12\App_Data\Database1.mdf;Integrated Security=True";

        protected void Page_Load(object sender, EventArgs e)
        {
            if (!IsPostBack)
            {
                LoadSummary();
                LoadPlacements();
            }
        }

        private void LoadSummary()
        {
            using (SqlConnection con = new SqlConnection(cs))
            {
                con.Open();

                SqlCommand cmd = new SqlCommand(
                    "SELECT COUNT(*) FROM Students", con);

                int total = Convert.ToInt32(cmd.ExecuteScalar());
                lblTotal.Text = total.ToString();

                cmd.CommandText =
                    "SELECT COUNT(DISTINCT StudentId) FROM Students";

                int placed = Convert.ToInt32(cmd.ExecuteScalar());
                lblPlaced.Text = placed.ToString();

                int unplaced = total - placed;
                lblUnplaced.Text = unplaced.ToString();

                cmd.CommandText =
                    "SELECT MAX(PackageLPA) FROM Students";

                object result = cmd.ExecuteScalar();

                decimal highest = (result == DBNull.Value || result == null)
                    ? 0
                    : Convert.ToDecimal(result);

                lblHighestPackage.Text = highest.ToString("N2");

                decimal percentage = total == 0
                    ? 0
                    : (decimal)placed * 100 / total;

                lblPercentage.Text = percentage.ToString("N2") + "%";
            }
        }

        private void LoadPlacements()
        {
            using (SqlConnection con = new SqlConnection(cs))
            {
                string query = "SELECT * FROM Students";

                SqlDataAdapter da = new SqlDataAdapter(query, con);
                DataTable dt = new DataTable();

                da.Fill(dt);

                gvPlacements.DataSource = dt;
                gvPlacements.DataBind();
            }
        }

        protected void btnReport_Click(object sender, EventArgs e)
        {
            Response.Redirect("~/Companies.aspx");
        }
    }
}

